# HUE Environment Configuration
# Copy to .env and configure for your deployment

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=*

# AI Gateway
# Compatible with OpenAI, LiteLLM, Cloudflare AI Gateway, OpenRouter, etc.
AI_GATEWAY_URL=https://api.openai.com/v1
AI_GATEWAY_API_KEY=
AI_VISION_MODEL=gpt-4o
AI_TEXT_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=45
AI_MAX_IMAGE_SIZE=10485760
AI_IMAGE_MAX_DIMENSION=1536
